# ---- Python build and cache artefacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
*.egg
.eggs/
wheelhouse/
pip-wheel-metadata/

# ---- test and coverage artefacts
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---- virtual environments
.venv/
venv/
env/
ENV/
.python-version

# ---- type checkers and linters
.mypy_cache/
.dmypy.json
.ruff_cache/

# ---- editor and OS state
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- notebook state
.ipynb_checkpoints/

# ---- LaTeX intermediates (documentation sources live under docs/)
*.aux
*.log
*.out
*.nav
*.snm
*.toc
*.vrb
*.synctex.gz
*.fls
*.fdb_latexmk
