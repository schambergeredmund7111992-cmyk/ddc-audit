# The source distribution ships the test suite, which needs the frozen
# reference artefact recorded under tests/data/ in order to compare the packaged
# metric against the reference implementation's output on any machine.
include tests/data/*.json
include LICENSE
include README.md
include CHANGELOG.md
include THIRD_PARTY_NOTICES.md
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * .pytest_cache
